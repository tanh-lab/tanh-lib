@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Components built into this installation, by public component name
# (Core, State, DSP, Resonator, Modulation, AudioIO). Each maps to an imported
# target tanh::<Component>.
set(tanh_AVAILABLE_COMPONENTS @TANH_EXPORTED_COMPONENTS@)

# Every component other than Core depends on Core; Modulation additionally
# depends on State and DSP. Resolve the closure of what was requested.
set(_tanh_required ${tanh_FIND_COMPONENTS})
if(NOT _tanh_required)
    set(_tanh_required ${tanh_AVAILABLE_COMPONENTS})
endif()
if("Modulation" IN_LIST _tanh_required)
    list(APPEND _tanh_required State DSP)
endif()
if(NOT "Core" IN_LIST _tanh_required)
    list(APPEND _tanh_required Core)
endif()
list(REMOVE_DUPLICATES _tanh_required)

foreach(_comp IN LISTS _tanh_required)
    if(NOT _comp IN_LIST tanh_AVAILABLE_COMPONENTS)
        set(tanh_FOUND FALSE)
        set(tanh_NOT_FOUND_MESSAGE
            "Component '${_comp}' is not part of this installation. Available components: ${tanh_AVAILABLE_COMPONENTS}")
        return()
    endif()
endforeach()

# Third-party dependencies exported alongside the components that use them.
if("State" IN_LIST _tanh_required)
    find_dependency(nlohmann_json)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/tanhTargets.cmake")

foreach(_comp IN LISTS _tanh_required)
    if(NOT TARGET tanh::${_comp})
        set(tanh_FOUND FALSE)
        set(tanh_NOT_FOUND_MESSAGE "Imported target tanh::${_comp} is missing from tanhTargets.cmake")
        return()
    endif()
    set(tanh_${_comp}_FOUND TRUE)
endforeach()

set(TANH_VERSION "@PROJECT_VERSION_FULL@")
check_required_components(tanh)
