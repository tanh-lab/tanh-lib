#pragma once

/// @file AbiNamespace.h
/// @brief THL_ABI_NAMESPACE — the inline namespace every tanh-lib declaration lives in.
///
/// Every namespace of tanh-lib is opened as `namespace thl::inline THL_ABI_NAMESPACE::core {`,
/// so `thl::core::Logger` is `thl::@THL_ABI_NAMESPACE@::core::Logger` for the compiler and the
/// linker. Code keeps spelling `thl::...`; the inline namespace only changes the mangled names.
/// Two core libraries built with different namespaces (tanh-lib's own, v<major>_<minor> by
/// default, and an embedder's private copy) therefore share no symbol and no state in one
/// process.
///
/// The value is the one the library was built with: the header lives in the library's
/// generated include directory and is installed with it. Code outside tanh-lib must not
/// forward-declare tanh-lib types; it includes their headers.
#define THL_ABI_NAMESPACE @THL_ABI_NAMESPACE@
